# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=tu_password_seguro_aqui
DB_HOST=192.168.11.223
DB_PORT=5432
DB_NAME=apollosupport_db

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
APOLLO_SECRET_KEY=cambia_esto_por_un_secreto_aleatorio_de_64_chars

# ── ERP / Integración local ───────────────────────────────────────────────────
ERP_REMOTE_HOST=http://192.168.11.223

# ── Configuración del servidor (opcional, defaults en main.py) ────────────────
