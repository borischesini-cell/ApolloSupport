# =============================================================================
# ApolloSupport Backend — Variables de Entorno
# Copiar como .env y completar con valores reales (NUNCA subir .env a git)
# =============================================================================

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=tu_password_seguro_aqui
DB_HOST=192.168.11.223
DB_PORT=5432
DB_NAME=apollosupport_db

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
APOLLO_SECRET_KEY=cambia_esto_por_un_secreto_aleatorio_de_64_chars

# ── ERP / Integración local ───────────────────────────────────────────────────
ERP_REMOTE_HOST=http://192.168.11.223
# Gescom SQL (CBU / ventas_ClienDA). Defaults = gescomOne mysql_login.php
# GESCOM_SQL_HOST=127.0.0.1
# GESCOM_SQL_PORT=3316
# GESCOM_SQL_DB=agc_sql_grupomaster
# GESCOM_SQL_USER=root
# GESCOM_SQL_PASSWORD=ingenieria
# Proxy dispositivos móviles (misi_licand en masterisi.com.ar)
# ANDROID_PROXY_URL=https://www.masterisi.com.ar/WebService/android_proxy.php
# ANDROID_PROXY_TOGGLE_URL=https://www.masterisi.com.ar/WebService/android_proxy_toggle.php
# ANDROID_PROXY_KEY=Apollo_Masterisi_Proxy_2025_SecureKey
# MySQL directo licenmovil (solo si el servidor Support tiene IP permitida en masterisi)
# LICENMOVIL_MYSQL_HOST=masterisi.com.ar
# CLIGESCO.DBF: en producción entrar por UNC/IP, sin mapear M:
# M: == \\192.168.10.24\X
# CLIGESCO_DBF=\\192.168.10.24\X\programa\CLIGESCO.DBF
# CLIGESCO_DBF_UNC=\\192.168.10.24\X\programa\CLIGESCO.DBF
# CLIGESCO_DBF_EXTRA=
# GesCom SQL por IP (defaults: 127.0.0.1 y 192.168.11.223:3316)
# GESCOM_SQL_HOST=192.168.11.223
# GesActi → Support (alta/baja/modi). Misma clave en X:\Util_Activacion
# GESACTI_SYNC_KEY=Apollo_GesActi_Sync_2026

# ── ApolloIA (Django api.ultimate) — consumo / billing en Centinela ───────────
# IA_API_URL=https://api.ultimate.net.ar/
# IA_API_KEY=tu_apikey_master
# IA_SERIAL_GESCOM=serial_master_habilitado

# ── Configuración del servidor (opcional, defaults en main.py) ────────────────
# PORT=8001
# LOG_LEVEL=info

# ── WebRTC / Canal rápido (P2P). El video no pasa por el API. ────────────────
# STUN público alcanza para muchos NAT. Clientes con NAT simétrico necesitan TURN.
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# WEBRTC_TURN_URL=turn:support.ultimate.net.ar:3478
# WEBRTC_TURN_USER=apollo
# WEBRTC_TURN_PASS=cambia_esto

# ── Agenda: grabaciones + videoconferencias Jitsi ─────────────────────────────
# JITSI_BASE_URL=https://meet.jit.si
# RECORDINGS_DIR=C:\ApolloSupport\backend\recordings
# RECORDINGS_RETENTION_DAYS=30
# RECORDINGS_FPS=3
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=soporte@tu-empresa.com
# SMTP_PASSWORD=tu_password
# SMTP_FROM=soporte@tu-empresa.com
# SMTP_USE_TLS=1

# ── WhatsApp Business Platform (Cloud API de Meta) ────────────────────────────
# Clave maestra para cifrar los tokens de cada línea (whatsapp.py la exige).
# Generar una: python -c "import secrets; print(secrets.token_hex(32))"
# APOLLO_SECRET_KEY=
# Firma HMAC-SHA256 de los webhooks: App secret de la app de Meta (App Dashboard > Webhooks).
# Sin este valor el webhook rechaza todo POST.
# WA_APP_SECRET=
# Token que se pega en "Verify token" al suscribir el webhook en Meta. Cualquier string.
# WA_WEBHOOK_VERIFY_TOKEN=
# Opcionales (defaults en whatsapp.py)
# WA_GRAPH_VERSION=v23.0
# WA_GRAPH_BASE=https://graph.facebook.com/v23.0
# WA_GRAPH_TIMEOUT=30
# Prefijo para números sin código de país (54 = Argentina)
# WA_DEFAULT_COUNTRY_CODE=54
# Costo lista Meta por mensaje entregado, en la moneda de rate_currency de la cuenta (USD para AR).
# service es siempre 0; utility/authentication se facturan sólo fuera de la ventana del cliente.
# WA_RATE_UTILITY=0.0225
# WA_RATE_MARKETING=0.0625
# WA_RATE_AUTHENTICATION=0.0375
# Margen que se suma al costo para la factura mensual al cliente (%)
# WA_MARKUP_PCT=30
# 1 = acepta webhooks sin firma. SOLO para pruebas locales, nunca en producción.
# WA_ALLOW_UNSIGNED_WEBHOOK=0
# Canal ERP (ApolloGesCom -> /api/whatsapp/erp/*). La api_key de cada cliente se guarda
# en Client.apikey_apollo; el puesto la pide en cada arranque con X-GesActi-Key, así que
# GESACTI_SYNC_KEY (arriba) tiene que estar definida con un valor propio, no el default.
# Máximo de reloj desincronizado entre puesto y servidor, en segundos.
# WA_ERP_MAX_SKEW_SECONDS=300
# Ventana anti-replay del nonce, en segundos.
# WA_ERP_NONCE_TTL_SECONDS=900
# PDF máximo admitido, en MB.
# WA_ERP_MAX_PDF_MB=8
# Plantilla UTILITY de factura y su idioma, la que usa el canal cuando Meta cierra la ventana.
# WA_ERP_INVOICE_TEMPLATE=factura_apollo
# WA_ERP_INVOICE_LANGUAGE=es
