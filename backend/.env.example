# =============================================================================
# ApolloSupport Backend — Variables de Entorno
# Copiar como .env y completar con valores reales (NUNCA subir .env a git)
# =============================================================================

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=tu_password_seguro_aqui
DB_HOST=192.168.11.223
DB_PORT=5432
DB_NAME=apollosupport_db

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
APOLLO_SECRET_KEY=cambia_esto_por_un_secreto_aleatorio_de_64_chars

# ── ERP / Integración local ───────────────────────────────────────────────────
ERP_REMOTE_HOST=http://192.168.11.223
# Proxy dispositivos móviles (misi_licand en masterisi.com.ar)
# ANDROID_PROXY_URL=https://www.masterisi.com.ar/WebService/android_proxy.php
# ANDROID_PROXY_TOGGLE_URL=https://www.masterisi.com.ar/WebService/android_proxy_toggle.php
# ANDROID_PROXY_KEY=Apollo_Masterisi_Proxy_2025_SecureKey
# MySQL directo licenmovil (solo si el servidor Support tiene IP permitida en masterisi)
# LICENMOVIL_MYSQL_HOST=masterisi.com.ar
# Copias de CLIGESCO.DBF. La tabla viva es M:\programa\
# CLIGESCO_DBF=m:\programa\CLIGESCO.DBF
# CLIGESCO_DBF_EXTRA=p:\ApolloSupport\bases\CLIGESCO.DBF

# ── ApolloIA (Django api.ultimate) — consumo / billing en Centinela ───────────
# IA_API_URL=https://api.ultimate.net.ar/
# IA_API_KEY=tu_apikey_master
# IA_SERIAL_GESCOM=serial_master_habilitado

# ── Configuración del servidor (opcional, defaults en main.py) ────────────────
# PORT=8001
# LOG_LEVEL=info

# ── Agenda: grabaciones + videoconferencias Jitsi ─────────────────────────────
# JITSI_BASE_URL=https://meet.jit.si
# RECORDINGS_DIR=C:\ApolloSupport\backend\recordings
# RECORDINGS_RETENTION_DAYS=30
# RECORDINGS_FPS=3
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=soporte@tu-empresa.com
# SMTP_PASSWORD=tu_password
# SMTP_FROM=soporte@tu-empresa.com
# SMTP_USE_TLS=1
